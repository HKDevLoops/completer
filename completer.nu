# ============================================================================
# completer.nu - Nushell-native modular completion manager (Nushell 0.116).
# Native APIs only: def / export def, match, named context params (token/place/
# buffer), $env.config.completions.external, source, save --append, open,
# lines, path join / expand / basename / exists, complete, which.
#
# ZERO WORK AT STARTUP: every top-level form below is only a def/export def.
# ============================================================================

# --- internal helpers --------------------------------------------------------

def completer-root [] {
    let from_env = ($env.COMPLETER_ROOT? | default "")
    if ($from_env | is-not-empty) { return ($from_env | path expand) }
    ($env.XDG_CONFIG_HOME? | default ($nu.home-dir | path join ".config")
        | path join "completer" | path expand)
}

def completer-token [shell: string] {
    match ($shell | str lowercase) {
        'pwsh' => 'powershell'
        'nu' | 'nushell' => 'nushell'
        _ => ($shell | str lowercase)
    }
}

def completer-ext [shell: string] {
    match ($shell | str lowercase) {
        'pwsh' => 'ps1'
        'nu' | 'nushell' => 'nu'
        'xonsh' => 'xsh'
        _ => ($shell | str lowercase)
    }
}

def completer-main-config [shell: string] {
    let cfg = ($env.XDG_CONFIG_HOME? | default ($nu.home-dir | path join ".config"))
    let ext = (completer-ext $shell)
    match ($shell | str lowercase) {
        'nu' | 'nushell' => ($cfg | path join "nushell" "config.nu" | path expand)
        'xonsh' => ($cfg | path join "xonsh" ".xonshrc" | path expand)
        _ => ($cfg | path join "completer" $"($shell)-completion.($ext)" | path expand)
    }
}

# Re-run safety: copy existing target to a timestamped .bak before touching it.
def completer-backup [path: string] {
    if not ($path | path exists) { return }
    let stamp = (date now | format date '%Y%m%d-%H%M%S')
    let dest = $"($path).bak.($stamp)"
    if not ($dest | path exists) { cp $path $dest }
    print $"  backup -> ($dest)"
}

def completer-capture [cmd: string, args: list<string>] {
    let r = (^$cmd ...$args | complete)
    if ($r.exit_code == 0 and ($r.stdout | str trim | is-not-empty)) { $r.stdout } else { null }
}

# Guarded, idempotent source line. `source` needs a parse-time constant path,
# so the literal ABSOLUTE path is written into the config at generation time.
def completer-link [config: string, file: string, shell: string] {
    if not ($config | path exists) { return }
    let abs = ($file | path expand)
    let name = ($abs | path basename)
    let content = (open --raw $config)
    let marker = $"# >>> completer:($shell):($name) >>>"
    if ($content | str contains $marker) { return }
    let load = match ($shell | str lowercase) {
        'nu' | 'nushell' | 'fish' => $"source '($abs)'"
        'xonsh' => $"execx(open('($abs)').read(), 'exec', __xonsh__.ctx)"
        _ => $". '($abs)'"
    }
    let block = $"\n($marker)\n($load)\n# <<< completer:($shell):($name) <<<\n"
    $block | save --append $config
    print $"  linked -> ($config)"
}

# --- completion acquisition --------------------------------------------------

def completer-native-spec [shell: string] {
    let subs = ['upgrade' 'update' 'uninstall' 'acp' 'api' 'debug' 'auth' 'mcp' 'plugin' 'models' 'stats' 'mini' 'run' 'session' 'service' 'reload' 'pair' 'serve']
    let flags = ['--help' '--version' '--wizard' '--completions' '--log-level' '--print-logs' '--standalone' '--server' '--auto' '--continue' '--session' '--prompt']
    let values = ($subs ++ $flags | each {|x| $"'($x)'"} | str join ", ")
    if ($shell in ['nu' 'nushell']) {
        $"# context-aware completer: named params token / place / buffer\ndef nu-complete-opencode [token: record, place: record, buffer: string] {\n    [($values)] | where {|v| $v | str starts-with $token.text }\n}\n@complete nu-complete-opencode\nextern opencode [...args]\n"
    } else {
        $"# Generated by completer - opencode native spec\n_opencode_subcommands = [($subs | str join ', ')]\n_opencode_flags = [($flags | str join ', ')]"
    }
}

def completer-program-output [program: string, shell: string, token: string] {
    for probe in [
        [$program 'completion' '--shell' $token]
        [$program 'completion' '-s' $token]
        [$program 'completion' $token]
        [$program 'completions' $token]
        [$program '--generate-completion' $token]
        [$program '--completions' $token]
    ] {
        let cmd = $probe | first
        if (which $cmd | is-not-empty) {
            let out = (completer-capture $cmd ($probe | skip 1))
            if ($out != null) { return $out }
        }
    }
    if (which carapace | is-not-empty) {
        let out = (completer-capture 'carapace' [$program $token])
        if ($out != null) { return $out }
    }
    if (($program | str lowercase) == 'opencode') { return (completer-native-spec $shell) }
    null
}

# Nushell files always install the documented external completer closure form.
def completer-nu-script [program: string, captured: any] {
    let external = "# >>> completer:external:nu >>>\n$env.config.completions.external.completer = {|place| carapace $place.command.0 nushell ...$place.command | from json }\n# <<< completer:external:nu <<<\n"
    if ($captured != null) {
        $"($external)\n($captured)\n"
    } else {
        $"($external)\n# no native completion captured for ($program)\n"
    }
}

# --- alias management --------------------------------------------------------

def add-alias [name: string, value: string] {
    let file = ((completer-root) | path join "alias.nu")
    let line = $"alias ($name) = ($value)"
    if ($file | path exists) {
        completer-backup $file
        let keep = (open --raw $file | lines | where {|l| not ($l | str starts-with $"alias ($name) =") })
        (($keep | append $line | str join "\n") + "\n") | save -f $file
    } else {
        (("# alias.nu - managed by completer (source in config.nu)\n" + $line) + "\n") | save -f $file
    }
    print $"  alias ($name) -> ($value) in ($file)"
}

def remove-alias [name: string] {
    let file = ((completer-root) | path join "alias.nu")
    if not ($file | path exists) { return }
    completer-backup $file
    let keep = (open --raw $file | lines | where {|l| not ($l | str starts-with $"alias ($name) =") })
    (($keep | str join "\n") + "\n") | save -f $file
    print $"  alias ($name) removed"
}

# --- carapace / zoxide -------------------------------------------------------

def completer-update-carapace [] {
    if (which carapace | is-empty) { print "carapace not found; nothing to update"; return }
    print "Refreshing carapace indexes (native carapace CLI)..."
    ^carapace --clear-cache | complete | ignore
    let n = (^carapace --list | complete | get stdout | lines | length)
    print $"  indexed completers: ($n)"
    let dir = ((completer-root) | path join "completions")
    if not ($dir | path exists) { mkdir $dir }
    for sh in ['bash' 'zsh' 'fish' 'powershell' 'nushell' 'xonsh'] {
        let ext = (completer-ext $sh)
        let out = ($dir | path join $"carapace-($sh)-init.($ext)" | path expand)
        let r = (^carapace _carapace $sh | complete)
        if ($r.exit_code == 0 and ($r.stdout | str trim | is-not-empty)) {
            completer-backup $out
            $r.stdout | save -f $out
            print $"  indexed: ($sh) -> ($out)"
            completer-link (completer-main-config $sh) $out $sh
        }
    }
    print "Carapace index refreshed."
}

def completer-add-zoxide [shell: string] {
    if (which zoxide | is-empty) { print "zoxide not found; nothing to do"; return }
    let sl = ($shell | str lowercase)
    let token = (completer-token $sl)
    let r = if ($sl in ['pwsh' 'powershell']) {
        (^zoxide init $token --cmd cd | complete)
    } else {
        (^zoxide init $token | complete)
    }
    if ($r.exit_code != 0 or ($r.stdout | str trim | is-empty)) { print $"no zoxide init for ($shell)"; return }
    let ext = (completer-ext $sl)
    let out = ((completer-root) | path join "completions" $"($sl)-zoxide-init.($ext)" | path expand)
    completer-backup $out
    $r.stdout | save -f $out
    print $"  wrote zoxide init -> ($out)"
    completer-link (completer-main-config $sl) $out $sl
}

# --- context-aware completer for the `completer` command itself --------------
# Nushell 0.116 named context params: token / place / buffer.
# Deprecated positional signatures ([context: string], [spans: list]) are NOT used.
def "nu-complete completer action" [token: record, place: record, buffer: string] {
    let typed = $token.text
    let base = ['list' 'zoxide' 'alias' 'update' 'pwsh' 'powershell' 'bash' 'zsh' 'fish' 'sh' 'nu' 'nushell' 'xonsh']
    let pool = if ($buffer | str contains ' alias ') { ['add' 'remove'] } else { $base }
    $pool | where {|x| $x | str starts-with $typed }
}

# --- public entrypoint -------------------------------------------------------

export def completer [
    action: string@"nu-complete completer action"
    ...programs: string
] {
    let root = (completer-root)
    let dir = ($root | path join "completions")
    if not ($dir | path exists) { mkdir $dir }
    let sl = ($action | str lowercase)
    match $sl {
        'list' => {
            ls $dir
        }
        'zoxide' => {
            let targets = if ($programs | is-empty) { ['pwsh' 'nu' 'xonsh'] } else { $programs }
            for z in $targets { completer-add-zoxide $z }
        }
        'update' => {
            let target = ($programs | get 0? | default '' | str lowercase)
            if $target == 'carapace' { completer-update-carapace }
            else { print "Unknown update target. Try: completer update carapace" }
        }
        'alias' => {
            let sub = ($programs | get 0? | default '' | str lowercase)
            match $sub {
                'add' => {
                    if ($programs | length) < 3 { print "usage: completer alias add <name> <value>"; return }
                    add-alias ($programs | get 1) ($programs | skip 2 | str join ' ')
                }
                'remove' => {
                    if ($programs | length) < 2 { print "usage: completer alias remove <name>"; return }
                    remove-alias ($programs | get 1)
                }
                _ => { print "usage: completer alias add <name> <value> | remove <name>" }
            }
        }
        _ => {
            let token = (completer-token $sl)
            let ext = (completer-ext $sl)
            let progs = if ($programs | is-empty) { ['opencode'] } else { $programs }
            for prog in $progs {
                print $"Generating ($prog) completions for ($sl)..."
                let out = ($dir | path join $"($sl)-($prog)-completion.($ext)" | path expand)
                let captured = (completer-program-output $prog $sl $token)
                let text = if ($sl in ['nu' 'nushell']) {
                    (completer-nu-script $prog $captured)
                } else if $captured != null {
                    $captured
                } else {
                    null
                }
                if ($text == null) { print $"  no completion for ($prog) ($sl)"; continue }
                completer-backup $out
                let header = $"\n# >>> completer:($prog):($sl) generated (date now | format date '%+') >>>\n"
                let footer = $"\n# <<< completer:($prog):($sl) <<<\n"
                # Replace a previously generated block for this program/shell,
                # otherwise append. One program per file.
                let begin = $"# >>> completer:($prog):($sl)"
                let existing = if ($out | path exists) { (open --raw $out) } else { "" }
                if ($existing | str contains $begin) {
                    (($header + $text) + $footer) | save -f $out
                } else {
                    (($header + $text) + $footer) | save -f --append $out
                }
                print $"  wrote -> ($out)"
                completer-link (completer-main-config $sl) $out $sl
            }
        }
    }
}
