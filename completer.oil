# ============================================================================
# completer.oil - Oil (osh/ysh) native modular completion manager.
#
# ZERO STARTUP WORK: sourcing this file only DEFINES functions. No probing,
# no config writes happen at load time.
#
# Native APIs used (official docs below):
#   name() { ... } / local / alias / unalias / source / command -v
#   complete / compgen / compopt  (bash-compatible completion builtins in OSH)
#   source <(carapace _carapace)  (documented Oil carapace bridge)
#   zoxide generic: `zoxide init posix --hook prompt` (no osh/ysh init exists)
#
# Official docs:
#   https://www.oils.pub/release/latest/doc/completion.html
#   https://www.oils.pub/release/latest/doc/ref/chap-builtin-cmd.html
#   https://www.oils.pub/release/latest/doc/getting-started.html
#   https://www.oilshell.org/blog/2018/10/10.html
#   https://carapace-sh.github.io/carapace-bin/setup.html#oil
#   https://github.com/ajeetdsouza/zoxide#setup-zoxide-on-your-shell
#
# GAPs vs the universal surface:
#   - `complete -F ...` self-registration is feasible in principle (bash-compatible
#     API) but the official docs retrieved carry no verbatim `complete -F` snippet;
#     our registration is a direct application of the documented bash-compatible
#     mechanism, marked as derived here.
#   - No `zoxide init osh/ysh` command is documented; generic POSIX init is used.
#   - Config-dir naming conflict: official docs say ~/.config/oils/oshrc while
#     carapace uses ${UserConfigDir}/oil/oshrc; we target ~/.config/oils/oshrc.
#   - OSH completion deals in argv entries (not command strings); quoting is done
#     by the shell. No Windows config path is documented.
# ============================================================================

_completer_root() {
    if [ -n "$COMPLETER_ROOT" ]; then printf '%s' "$COMPLETER_ROOT"; return; fi
    printf '%s' "${XDG_CONFIG_HOME:-$HOME/.config}/completer"
}

_completer_token() {
    case "$1" in
        nu|nushell) printf 'nushell' ;;
        pwsh|powershell) printf 'powershell' ;;
        *) printf '%s' "$1" ;;
    esac
}

_completer_ext() {
    case "$1" in
        nu|nushell) printf 'nu' ;; xonsh) printf 'xsh' ;; pwsh|powershell) printf 'ps1' ;;
        *) printf '%s' "$1" ;;
    esac
}

# Reject names that could escape the completions dir or inject generated text.
_completer_valid_name() {
    case "$1" in
        ''|*[!A-Za-z0-9_.-]*|*'..'*) return 1 ;;
    esac
    return 0
}

_completer_capture() {
    local out
    out=$("$@" 2>/dev/null) || return 1
    case "$out" in DESCRIPTION*|USAGE*|'') return 1 ;; esac
    printf '%s' "$out"
}

_completer_program_output() {
    local prog=$1 shell=$2 tok=$3 a out
    for a in "completion --shell $tok" "completion -s $tok" "completion $tok" \
             "completions $tok" "--generate-completion $tok" "--completions $tok"; do
        command -v "$prog" >/dev/null 2>&1 || continue
        out=$(_completer_capture "$prog" $a) && { printf '%s' "$out"; return 0; }
    done
    if command -v carapace >/dev/null 2>&1; then
        out=$(_completer_capture carapace "$prog" "$tok") && { printf '%s' "$out"; return 0; }
    fi
    return 1
}

# Single fixed backup per target (overwrite, no unbounded .bak.<stamp> growth).
_completer_backup() {
    [ -f "$1" ] || return 0
    cp -- "$1" "$1.bak" && printf '  backup -> %s.bak\n' "$1"
}

# Idempotent generated block: rewrite in place (one block) when the begin marker
# exists, otherwise append. Callers back up the target before invoking this.
_completer_write_block() {
    local out=$1 prog=$2 shell=$3 text=$4
    local begin="# >>> completer:$prog:$shell"
    if [ -f "$out" ] && grep -qF -- "$begin" "$out"; then
        { printf '\n# >>> completer:%s:%s generated %s >>>\n' "$prog" "$shell" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
          printf '%s\n' "$text"
          printf '\n# <<< completer:%s:%s <<<\n' "$prog" "$shell"; } > "$out"
    else
        { printf '\n# >>> completer:%s:%s generated %s >>>\n' "$prog" "$shell" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
          printf '%s\n' "$text"
          printf '\n# <<< completer:%s:%s <<<\n' "$prog" "$shell"; } >> "$out"
    fi
}

_completer_main_config() {
    local cfg=${XDG_CONFIG_HOME:-$HOME/.config}
    case "$1" in
        sh) printf '%s' "$HOME/.profile" ;;
        bash) printf '%s' "$HOME/.bashrc" ;;
        zsh) printf '%s' "$HOME/.zshrc" ;;
        oil|osh|ysh) printf '%s' "$cfg/oils/oshrc" ;;
        fish) printf '%s' "$cfg/fish/config.fish" ;;
        pwsh|powershell) printf '%s' "${HOME}/Documents/PowerShell/profile.ps1" ;;
        nu) printf '%s' "$cfg/nushell/config.nu" ;;
        xonsh) printf '%s' "$cfg/xonsh/.xonshrc" ;;
        *) printf '%s' "$cfg/completer/$1-completion.$(_completer_ext "$1")" ;;
    esac
}

_completer_link() {
    local config=$1 file=$2 shell=$3 marker load base
    [ -f "$config" ] || return 0
    base=${file##*/}
    marker="# >>> completer:$shell:$base >>>"
    grep -qF -- "$marker" "$config" && return 0
    case "$shell" in
        nu|fish) load="source '$file'" ;;
        xonsh) load="execx(open('$file').read(), 'exec', __xonsh__.ctx)" ;;
        oil|osh|ysh) load="source '$file'" ;;
        *) load=". '$file'" ;;
    esac
    { printf '\n%s\n%s\n# <<< completer:%s:%s <<<\n' \
        "$marker" "$load" "$shell" "$base"; } >> "$config"
    printf '  linked -> %s\n' "$config"
}

_completer_valid_value() {
    local v=$1 nl='
'
    case "$v" in *"'"*|*'"'*|*'`'*|*'$'*|*"$nl"*) return 1 ;; esac
    return 0
}

add-alias() {
    local name=$1; shift; local value="$*"
    _completer_valid_name "$name" || { printf 'invalid alias name: %s\n' "$name"; return 1; }
    _completer_valid_value "$value" || { printf 'invalid alias value: %s\n' "$value"; return 1; }
    local file; file="$(_completer_root)/alias.oil"
    mkdir -p "$(dirname "$file")"
    [ -f "$file" ] || printf '# alias.oil - managed by completer\n' > "$file"
    _completer_backup "$file"
    grep -vF "alias $name=" "$file" > "$file.tmp" || :
    mv "$file.tmp" "$file"
    printf "alias %s='%s'\n" "$name" "$value" >> "$file"
    alias "$name=$value"
    printf '  alias %s -> %s in %s\n' "$name" "$value" "$file"
}

remove-alias() {
    local name=$1
    _completer_valid_name "$name" || { printf 'invalid alias name: %s\n' "$name"; return 1; }
    local file; file="$(_completer_root)/alias.oil"
    [ -f "$file" ] || return 0
    grep -vE "^[[:space:]]*alias[[:space:]]+$name=" "$file" > "$file.tmp" && mv "$file.tmp" "$file"
    unalias "$name" 2>/dev/null || true
    printf '  alias %s removed\n' "$name"
}

# Self-completion for `completer` via the documented bash-compatible complete builtin.
_completer_self_complete() {
    local cur; cur=${COMP_ARGV[-1]:-$cur}
    COMPREPLY=()
    case "$cur" in
        a*) COMPREPLY=(add alias) ;;
        r*) COMPREPLY=(remove) ;;
        l*) COMPREPLY=(list) ;;
        u*) COMPREPLY=(update) ;;
        z*) COMPREPLY=(zoxide) ;;
        s*) COMPREPLY=(self) ;;
        *) COMPREPLY=(add remove list update zoxide self) ;;
    esac
}

_completer_register_self() {
    # Derived from the bash-compatible API documented at ref/chap-builtin-cmd.html.
    complete -F _completer_self_complete completer 2>/dev/null || true
    printf 'Self-completion registered via OSH bash-compatible complete -F.\n'
}

_completer_update_carapace() {
    if ! command -v carapace >/dev/null 2>&1; then
        printf 'carapace not found; nothing to update\n'; return 0
    fi
    printf 'Refreshing carapace indexes (native carapace CLI)...\n'
    local dir; dir="$(_completer_root)/completions"
    mkdir -p "$dir"
    carapace --clear-cache >/dev/null 2>&1 || true
    local n; n=$(carapace --list 2>/dev/null | wc -l)
    printf '  indexed completers: %s\n' "$n"
    local sh out res
    for sh in bash zsh fish powershell nushell xonsh; do
        out="$dir/carapace-$sh-init.$(_completer_ext "$sh")"
        res=$(carapace _carapace "$sh" 2>/dev/null) || continue
        [ -n "$res" ] || continue
        _completer_backup "$out"
        printf '%s\n' "$res" > "$out"
        printf '  indexed: %s -> %s\n' "$sh" "$out"
    done
    # Documented Oil bridge line, emitted for the user's oshrc if desired:
    local bridge="$dir/carapace-oil-bridge.sh"
    _completer_backup "$bridge"
    printf '# >>> completer:carapace:oil >>>\nexport CARAPACE_BRIDGES=%s\nsource <(carapace _carapace)\n# <<< completer:carapace:oil <<<\n' \
        "'zsh,fish,bash,inshellisense'" > "$bridge"
    printf '  bridge snippet -> %s\n' "$bridge"
    printf 'Carapace index refreshed.\n'
}

_completer_zoxide() {
    command -v zoxide >/dev/null 2>&1 || { printf 'zoxide not found; nothing to do\n'; return 0; }
    local shell=$1 tok out text
    _completer_valid_name "$shell" || { printf 'invalid shell name: %s\n' "$shell"; return 1; }
    tok=$(_completer_token "$shell")
    # No osh/ysh init: use documented generic POSIX target.
    case "$shell" in
        oil|osh|ysh|sh) tok=posix ;;
    esac
    text=$(zoxide init "$tok" --hook prompt 2>/dev/null) || return 1
    [ -n "$text" ] || { printf 'no zoxide init for %s\n' "$shell"; return 1; }
    out="$(_completer_root)/completions/$shell-zoxide-init.$(_completer_ext "$shell")"
    _completer_backup "$out"
    printf '%s\n' "$text" > "$out"
    printf '  wrote zoxide init -> %s\n' "$out"
    _completer_link "$(_completer_main_config "$shell")" "$out" "$shell"
}

completer() {
    local action=$1; shift
    local -a progs; if [ $# -eq 0 ]; then progs=(opencode); else progs=("$@"); fi
    local root dir
    root=$(_completer_root); dir="$root/completions"
    mkdir -p "$dir"

    case "$action" in
        list) ls -l "$dir"; return 0 ;;
        self) _completer_register_self; return 0 ;;
        zoxide)
            if [ "${progs[0]}" = opencode ]; then set -- pwsh nu xonsh; fi
            for z in "$@"; do _completer_zoxide "$z"; done
            return 0 ;;
        update)
            if [ "${progs[0]}" = carapace ]; then _completer_update_carapace
            else printf 'Unknown update target. Try: completer update carapace\n'; fi
            return 0 ;;
        alias)
            case "${progs[0]}" in
                add) add-alias "${progs[1]}" "${progs[*]:2}" ;;
                remove) remove-alias "${progs[1]}" ;;
                *) printf 'usage: completer alias add <name> <value> | remove <name>\n' ;;
            esac
            return 0 ;;
    esac

    local shell=$action tok ext prog out text
    _completer_valid_name "$shell" || { printf 'invalid shell name: %s\n' "$shell"; return 1; }
    tok=$(_completer_token "$shell"); ext=$(_completer_ext "$shell")
    for prog in "${progs[@]}"; do
        _completer_valid_name "$prog" || { printf 'invalid program name: %s\n' "$prog"; continue; }
        printf 'Generating %s completions for %s...\n' "$prog" "$shell"
        out="$dir/$shell-$prog-completion.$ext"
        text=$(_completer_program_output "$prog" "$shell" "$tok") || { printf '  no completion for %s (%s)\n' "$prog" "$shell"; continue; }
        _completer_backup "$out"
        _completer_write_block "$out" "$prog" "$shell" "$text"
        printf '  wrote -> %s\n' "$out"
        _completer_link "$(_completer_main_config "$shell")" "$out" "$shell"
    done
    _completer_register_self
}
