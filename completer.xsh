# ============================================================================
# completer.xsh - xonsh-native modular completion manager.
#
# Native APIs only: aliases mapping, add_one_completer,
# contextual_command_completer, RichCompletion, execx, captured subprocess,
# pathlib.  Sourcing this file only DEFINES functions and wires the `completer`
# callable alias: no subprocesses are run and no files are touched at load.
# ============================================================================

import os as _co
import shutil as _cs
import subprocess as _cp
from pathlib import Path as _P
from datetime import datetime as _dt


# ---------------------------------------------------------------- path helpers
def _root():
    """Storage root; $COMPLETER_ROOT overrides the XDG default."""
    r = __xonsh__.env.get("COMPLETER_ROOT")
    if r:
        return str(r)
    cfg = __xonsh__.env.get("XDG_CONFIG_HOME") or str(_P.home() / ".config")
    return str(_P(cfg) / "completer")


def _which(name):
    return _cs.which(name)


def _capture(program, args):
    """Run a program with captured output; return stdout when it looks usable."""
    try:
        p = _cp.run([program] + list(args), capture_output=True, text=True,
                    timeout=10)
        out = p.stdout or ""
        if (p.returncode == 0 and out.strip()
                and not out.lstrip().startswith(("DESCRIPTION", "USAGE"))):
            return out
    except Exception:
        pass
    return None


def _token(shell):
    """Map a shell name to the token its completion generators expect."""
    return {"pwsh": "powershell", "nu": "nushell",
            "nushell": "nushell"}.get(shell.lower(), shell.lower())


def _ext(shell):
    """File extension for a generated completion script of this shell."""
    return {
        "pwsh": "ps1", "powershell": "ps1",
        "nu": "nu", "nushell": "nu",
        "xonsh": "xsh",
        "bash": "bash", "zsh": "zsh", "fish": "fish", "sh": "sh",
    }.get(shell.lower(), shell.lower())


def _main_config(shell):
    """Primary config file of the target shell where link blocks are appended."""
    cfg = __xonsh__.env.get("XDG_CONFIG_HOME") or str(_P.home() / ".config")
    s = shell.lower()
    if s in ("nu", "nushell"):
        return str(_P(cfg) / "nushell" / "config.nu")
    if s == "xonsh":
        return str(_P(cfg) / "xonsh" / ".xonshrc")
    if s in ("pwsh", "powershell"):
        return str(_P(cfg) / "powershell" / "Microsoft.PowerShell_profile.ps1")
    if s == "bash":
        return str(_P.home() / ".bashrc")
    if s == "zsh":
        return str(_P.home() / ".zshrc")
    if s == "fish":
        return str(_P(cfg) / "fish" / "config.fish")
    if s == "sh":
        return str(_P.home() / ".profile")
    return str(_P(_root()) / ("%s-completion.%s" % (s, _ext(s))))


def _backup(path):
    """Copy an existing target to <path>.bak.<timestamp> before any change."""
    p = _P(path)
    if p.exists():
        dest = str(p) + ".bak." + _dt.now().strftime("%Y%m%d-%H%M%S")
        _cs.copy2(str(p), dest)
        print("  backup -> " + dest)


def _link(config, file, shell):
    """Append a guarded, marker-delimited loader line to the shell config."""
    p = _P(config)
    p.parent.mkdir(parents=True, exist_ok=True)
    existed = p.exists()
    if not existed:
        p.write_text("", encoding="utf-8")
    content = p.read_text(encoding="utf-8", errors="ignore")
    name = _P(file).name
    marker = "# >>> completer:%s:%s >>>" % (shell, name)
    if marker in content:                    # idempotent: never duplicate
        return
    if existed:
        _backup(config)
    fwd = file.replace("\\", "/")
    if shell.lower() == "xonsh":
        # Native xonsh loading of a generated script in the live session ctx.
        load = "execx(open('%s').read(), 'exec', __xonsh__.ctx)" % fwd
    elif shell.lower() in ("nu", "nushell", "fish"):
        load = "source '%s'" % fwd
    else:
        load = ". '%s'" % file
    block = "\n%s\n%s\n# <<< completer:%s:%s <<<\n" % (marker, load, shell, name)
    with p.open("a", encoding="utf-8") as fh:
        fh.write(block)
    print("  linked -> " + config)


# --------------------------------------------------------- completion acquisition
def _native_spec(shell):
    """Static fallback for opencode on shells it cannot emit completions for."""
    subs = "upgrade update uninstall acp api debug auth mcp plugin models stats mini run session service reload pair serve".split()
    flags = "--help --version --wizard --completions --log-level --print-logs --standalone --server --auto --continue --session --prompt".split()
    if shell == "nu":
        return ("# Generated by completer - opencode native spec\n"
                "def 'opencode subcommands' [] { [" + ", ".join("'%s'" % s for s in subs) + "] }\n"
                "def 'opencode flags' [] { [" + ", ".join("'%s'" % f for f in flags) + "] }")
    # xonsh: emit a real native completer (loaded via execx into session ctx).
    return ("# Generated by completer - opencode native spec (xonsh)\n"
            "from xonsh.completers.tools import RichCompletion\n"
            "from xonsh.completers.completer import add_one_completer\n"
            "_opencode_items = [RichCompletion(x, description='opencode') for x in "
            + repr(subs + flags) + "]\n"
            "def _opencode_completer(ctx):\n"
            "    pre = getattr(ctx, 'prefix', '') or ''\n"
            "    return {c for c in _opencode_items if str(c).startswith(pre)}\n"
            "add_one_completer('opencode', _opencode_completer, 'start')\n")


def _program_output(program, shell, token):
    """Acquire a completion script using the SPEC's ordered strategy."""
    for probe in ([program, "completion", "--shell", token],
                  [program, "completion", "-s", token],
                  [program, "completion", token],
                  [program, "completions", token],
                  [program, "--generate-completion", token],
                  [program, "--completions", token]):
        if _which(probe[0]):
            out = _capture(probe[0], probe[1:])
            if out:
                return out
    if _which("carapace"):
        out = _capture("carapace", [program, token])
        if out:
            return out
    if program == "opencode" and shell in ("nu", "xonsh"):
        return _native_spec(shell)
    return None


# ------------------------------------------------------------- alias management
def add_alias(name, value):
    """Add/replace an alias in alias.xsh and in the LIVE aliases mapping."""
    f = _P(_root()) / "alias.xsh"
    f.parent.mkdir(parents=True, exist_ok=True)
    if not f.exists():
        f.write_text("# alias.xsh - managed by completer\n", encoding="utf-8")
    else:
        _backup(str(f))
    lines = [ln for ln in f.read_text(encoding="utf-8").splitlines()
             if not ln.strip().startswith("aliases['%s']" % name)]
    lines.append("aliases['%s'] = %r" % (name, value))
    f.write_text("\n".join(lines) + "\n", encoding="utf-8")
    aliases[name] = value                    # native xonsh aliases mapping
    print("  alias %s -> %s in %s" % (name, value, f))


def remove_alias(name):
    """Remove an alias from alias.xsh and from the LIVE aliases mapping."""
    f = _P(_root()) / "alias.xsh"
    if f.exists():
        _backup(str(f))
        lines = [ln for ln in f.read_text(encoding="utf-8").splitlines()
                 if not ln.strip().startswith("aliases['%s']" % name)]
        f.write_text("\n".join(lines) + "\n", encoding="utf-8")
    aliases.pop(name, None)                  # native xonsh aliases mapping
    print("  alias %s removed" % name)


# --------------------------------------------------------------- tool refreshes
def completer_update_carapace():
    """Refresh carapace's index with its native CLI and cache init scripts."""
    if not _which("carapace"):
        print("carapace not found; nothing to update")
        return
    print("Refreshing carapace indexes (native carapace CLI)...")
    _cp.run(["carapace", "--clear-cache"], capture_output=True)
    listing = _cp.run(["carapace", "--list"], capture_output=True, text=True)
    n = len([ln for ln in (listing.stdout or "").splitlines() if ln.strip()])
    print("  indexed completers: %d" % n)
    for sh in ["bash", "zsh", "fish", "powershell", "nushell", "xonsh"]:
        out = str(_P(_root()) / "completions" / ("carapace-%s-init.%s" % (sh, _ext(sh))))
        p = _cp.run(["carapace", "_carapace", sh], capture_output=True, text=True)
        if p.returncode == 0 and (p.stdout or "").strip():
            _backup(out)
            _P(out).write_text(p.stdout, encoding="utf-8")
            print("  indexed: %s -> %s" % (sh, out))
    print("Carapace index refreshed.")


def completer_zoxide(shell):
    """Generate and link zoxide's native init script for a shell."""
    if not _which("zoxide"):
        print("zoxide not found; nothing to do")
        return
    token = _token(shell)
    try:
        cmd = ["zoxide", "init", token]
        if shell in ("pwsh", "powershell"):
            cmd += ["--cmd", "cd"]
        p = _cp.run(cmd, capture_output=True, text=True)
    except Exception:
        p = None
    if not p or p.returncode != 0 or not (p.stdout or "").strip():
        print("no zoxide init for " + shell)
        return
    out = str(_P(_root()) / "completions" / ("%s-zoxide-init.%s" % (shell, _ext(shell))))
    _backup(out)
    _P(out).write_text(p.stdout, encoding="utf-8")
    print("  wrote zoxide init -> " + out)
    _link(_main_config(shell), out, shell)


# ------------------------------------------------------------------ main command
def completer(action=None, *programs):
    """completion manager entrypoint.

    Examples:
        completer pwsh opencode gh
        completer bash opencode gh
        completer alias add cplt 'completer'
        completer alias remove cplt
        completer list
        completer update carapace
        completer zoxide pwsh nu xonsh
    """
    _ensure_completer_registration()
    d = _P(_root()) / "completions"
    d.mkdir(parents=True, exist_ok=True)
    progs = [str(p) for p in programs] if programs else ["opencode"]
    action = (action or "").lower()

    if action in ("", "help", "-h", "--help"):
        print("usage:")
        print("  completer <shell> [program...]")
        print("  completer alias add <name> <value> | alias remove <name>")
        print("  completer list")
        print("  completer update carapace")
        print("  completer zoxide [shell...]")
        return
    if action == "list":
        files = sorted(d.iterdir())
        if not files:
            print("No generated completions yet (root: %s)" % _root())
        for f in files:
            print("%10d  %s" % (f.stat().st_size, f.name))
        return
    if action == "zoxide":
        targets = progs if not (len(progs) == 1 and progs[0] == "opencode") \
            else ["pwsh", "nu", "xonsh"]
        for z in targets:
            completer_zoxide(z)
        return
    if action == "update":
        if progs and progs[0] == "carapace":
            completer_update_carapace()
        else:
            print("Unknown update target. Try: completer update carapace")
        return
    if action == "alias":
        sub = progs[0] if progs else ""
        if sub == "add" and len(progs) >= 2:
            add_alias(progs[1], " ".join(progs[2:]))
        elif sub == "remove" and len(progs) >= 2:
            remove_alias(progs[1])
        else:
            print("usage: completer alias add <name> <value> | remove <name>")
        return

    shell = action
    token = _token(shell)
    ext = _ext(shell)
    for prog in progs:
        print("Generating %s completions for %s..." % (prog, shell))
        out = str(d / ("%s-%s-completion.%s" % (shell, prog, ext)))
        text = _program_output(prog, shell, token)
        if not text:
            print("  no completion for %s (%s)" % (prog, shell))
            continue
        _backup(out)
        header = "\n# >>> completer:%s:%s generated %s >>>\n" % (
            prog, shell, _dt.now().isoformat())
        footer = "\n# <<< completer:%s:%s <<<\n" % (prog, shell)
        # Replace a previously generated block for this program/shell, otherwise
        # append. One program per file; _backup already ran above.
        begin = "# >>> completer:%s:%s" % (prog, shell)
        existing = ""
        if _P(out).exists():
            existing = _P(out).read_text(encoding="utf-8", errors="ignore")
        mode = "w" if begin in existing else "a"
        with open(out, mode, encoding="utf-8") as fh:
            fh.write(header + text + footer)
        print("  wrote -> " + out)
        _link(_main_config(shell), out, shell)


# ------------------------------------------------- callable alias + self-complete
def _completer_entry(args=None):
    """Adapter for the `completer` command (xonsh passes a single token list)."""
    if args is None:
        tokens = []
    elif isinstance(args, str):
        tokens = args.split()
    else:
        tokens = [str(a) for a in args]
    if tokens:
        completer(tokens[0], *tokens[1:])
    else:
        completer()
    return 0


_completer_registered = False


def _ensure_completer_registration():
    """Install the live alias and self-completion on first use, never at load.

    Sourcing this file must only define functions: no alias wiring, no
    add_one_completer call and no xonsh completer imports happen until
    `completer` is actually invoked for the first time.
    """
    global _completer_registered
    if _completer_registered:
        return
    _completer_registered = True
    aliases['completer'] = _completer_entry   # native aliases mapping (entrypoint)
    try:                                       # self-completion for the command
        from xonsh.completers.tools import (
            contextual_command_completer as _ccc, RichCompletion as _RC)
        from xonsh.completers.completer import add_one_completer as _aoc

        @_ccc
        def _completer_self(ctx):
            pre = getattr(ctx, "prefix", "") or ""
            choices = ("list update carapace alias add remove zoxide "
                       "pwsh powershell bash zsh fish sh nu nushell xonsh").split()
            return {_RC(c, description="completer")
                    for c in choices if c.startswith(pre)}

        _aoc("completer", _completer_self, "start")
    except Exception:
        pass  # completion is a convenience; never break the first call
